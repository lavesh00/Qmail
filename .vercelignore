# What Vercel needs to upload is the source required to build the web client,
# and nothing else. Without this the CLI tries to push about 7.5 GB: two
# node_modules trees and the Android build output.

# Vercel runs the install itself.
node_modules
**/node_modules

# The mobile app plays no part in the web build. Its Expo dependency tree is
# over 2 GB and its Android build output another 2 GB, none of which would ever
# be executed here.
apps/mobile

# Build output, all of it regenerated by build:vercel.
dist
**/dist
packages/crypto/wasm
apps/web/dist

# Local-only.
.git
.expo
.vercel
*.log
coverage
