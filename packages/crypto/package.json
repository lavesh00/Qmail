{
  "name": "@qmail/crypto",
  "version": "0.1.0",
  "private": true,
  "description": "Shared post-quantum crypto module for Qmail. One implementation, consumed identically by web and mobile.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node scripts/vendor-wasm.mjs",
    "build": "tsc -p tsconfig.json",
    "vendor": "node scripts/vendor-wasm.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@oqs/liboqs-js": "^0.15.1",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@noble/post-quantum": "^0.6.1",
    "typescript": "^5.9.2"
  }
}
